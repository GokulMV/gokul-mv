# Rendered by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. ${PORT} is Railway's port (default 8080).
# An IPv6 listener is added at boot by docker/40-ipv6-listen.sh when the
# kernel supports it.

server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    charset utf-8;

    # ---- Compression -------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/wasm
        application/octet-stream
        image/svg+xml
        model/gltf+json
        font/ttf
        font/otf;

    # ---- Security headers --------------------------------------------------
    # Included here and again in every location that adds a header of its own
    # (NGINX does not inherit add_header into such a location).
    include /etc/nginx/snippets/security-headers.conf;

    # ---- Railway healthcheck -----------------------------------------------
    location = /healthz {
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 '{"status":"ok","service":"portfolio","port":"${PORT}","time":"$time_iso8601"}';
    }

    # ---- Fingerprinted build assets: cache forever --------------------------
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # ---- 3D models, textures, fonts, documents ------------------------------
    location ~* \.(?:glb|gltf|bin|ktx2|hdr|exr|png|jpe?g|webp|avif|svg|woff2?|ttf|otf|pdf|mp3|ogg|wav)$ {
        add_header Cache-Control "public, max-age=604800" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # ---- index.html must always be revalidated ------------------------------
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---- SPA fallback --------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
